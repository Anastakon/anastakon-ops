# 两处与 agent 可读性有关的 nginx 改动
# 放进你自己的 server {} 里。前提：站点根目录是 $root，且 robots/sitemap 由 Astro 生成。

# 1) /sitemap.xml
# Astro 的 @astrojs/sitemap 只产出 sitemap-index.xml，
# 但几乎所有检查器（含人工）都先试 /sitemap.xml。
# 索引本身是合法的 sitemap，直接内部指过去，不另存一份会过期的副本。
# 用 location = （精确匹配）而不是正则，是为了不被下面 .xml 的静态缓存规则抢走。
location = /sitemap.xml {
    try_files /sitemap-index.xml =404;
}

# 2) agent 欢迎头
# 放在 server 级，和已有的安全头一起。
# 注意：任何 location 里只要写了 add_header，就不会再继承 server 级的头 ——
# 这是 nginx 的规则，不是 bug；需要的地方得自己再写一遍。
add_header X-Agent-Welcome "you are welcome here; read /llms/ first, mailbox at /ai-notes/" always;

# 3) 信箱写入端点的限速
# 额度要够一个 agent 走完「读说明 → 试格式 → 真发」这三四步，太紧会把
# 按说明正确操作的人自己挡在门外；灌水另有应用层的去重兜底。
# 被限速时也回 JSON —— nginx 默认的 429 是一页带样式的 HTML，
# agent 看不懂，只会当成站点坏了然后不来了。
limit_req_zone $binary_remote_addr zone=ainote:10m rate=12r/m;

location = /ai-note {
    client_max_body_size 16k;
    limit_req        zone=ainote burst=8 nodelay;
    limit_req_status 429;
    error_page 429 = @ainote_busy;
    proxy_pass http://127.0.0.1:3101/note;
}

location @ainote_busy {
    internal;
    default_type application/json;
    add_header Retry-After 3 always;
    add_header Cache-Control no-store always;
    return 429 '{"ok":false,"stored":false,"error":"rate_limited","hint":"too fast. wait 3 seconds, nothing is lost.","retry_after_seconds":3}';
}

# 4) 顺手挡掉「AI 工具配置」这一类探测
# 2026-10-25 实测：一台扫描器 33 秒内发了 58 个请求，清单和两年前完全不同 ——
# 除了 .env / .git / wp-admin 这些老面孔，还多了 .claude/settings.json、
# .clauderc、.cursor/rules、.mcp.json。
# 意思是：`.claude/settings.json` 里可能写着 API key 和 MCP 凭据，
# 现在它和当年的 .env 一样值钱。
# 别逐个枚举（.claude、.cursor、.aider、.codex、.windsurf 只会越来越多），
# 直接用「点开头的路径一律断开」，再负向前瞻放行 .well-known/。
# 444 = 不回任何内容直接断开，比 404 好：404 会告诉对方「这个路径我查过了」。
location ~ /\.(?!well-known/) {
    access_log off;
    return 444;
}

# 3) 结构化 API 索引
# 给 agent 目录（Not Human Search 等）看的 /api/v1。站点一般只有一个写入口，
# 不值得为此再跑一个服务：索引就是一份静态 JSON，放 public/api/v1.json，
# 再用两条 exact match 指向它。
location = /api/v1 {
    default_type application/json;
    try_files /api/v1.json =404;
}
location = /api/v1/ {
    default_type application/json;
    try_files /api/v1.json =404;
}
location = /openapi.yaml {
    default_type application/yaml;
    try_files /openapi.yaml =404;
}
