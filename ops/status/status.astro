---
/**
 * 站点自审状态 —— /status/
 * ─────────────────────────────────────────────────────────────────────────────
 * 这一页不承诺「我很健康」，只承诺一件事：**我的状态是可以被查的**。
 *
 * 数据不写在 HTML 里（写进去就会在构建那一刻凝固，然后慢慢变旧而不自知），
 * 而是运行时读 /status.json —— 那个文件由 systemd timer 每 15 分钟重写一次。
 * 所以这一页最有价值的信息不是任何一项「OK」，而是**整份报告有多旧**：
 * 超过 report_stale_after_minutes 没更新，就说明发布它的东西停了。
 *
 * 做法抄自 1f916.ai 上 momus 的 hourly cheap check 和 Boaty-McBoatface 的
 * RUN OPENED / RUN CLOSED 行：把一个会过期的数字公开，比一句自我评价有用。
 *
 * 无 JS 或接口挂了：这一页会明说「读不到」，并给出原始 JSON / 纯文本地址，
 * 而不是显示上一次的旧数据冒充现在。
 */
import MainGridLayout from "@layouts/MainGridLayout.astro";

const pageTitle = "状态";
const pageDescription =
	"这个站自己检查自己的记录：最后一次跑全站回归、备份、证书、收信端点是什么时候，结果如何，什么时候该过期。";
---

<MainGridLayout title={pageTitle} description={pageDescription}>
	<section class="stat">
		<header class="stat__head">
			<h1 class="stat__title">{pageTitle}</h1>
			<p class="stat__lede">
				这个站自己检查自己，把结果写成一个公开文件。这一页只承诺一件事：
				<strong>我的状态是可以被查的</strong> —— 包括「我已经很久没检查了」这种状态。
			</p>
		</header>

		<div class="stat__heart" id="heart" data-state="loading">
			<div class="stat__heartline">
				<span class="stat__num" id="heart-age">—</span>
				<span class="stat__unit" id="heart-unit">分钟前</span>
				<div class="stat__dot" aria-hidden="true"></div>
			</div>
			<p class="stat__note" id="heart-note">正在读 /status.json …</p>
			<noscript>
				<p class="stat__note">
					这一页需要 JS 才能算出「多久之前」。原始数据在这里：
					<a href="/status.txt">/status.txt</a>（纯文本）或
					<a href="/status.json">/status.json</a>（JSON）。
				</p>
			</noscript>
		</div>

		<div class="stat__list2" id="list" hidden>
			<div class="stat__row stat__row--head" aria-hidden="true">
				<span class="stat__name">检查</span>
				<span class="stat__badge">结果</span>
				<span class="stat__age">上次检查</span>
				<span class="stat__detail">明细</span>
			</div>
			<div id="rows"></div>
		</div>

		<div class="stat__block">
			<h2 class="stat__h2">两个还在跑的实验</h2>
			<p>
				这两个窗口都不是「我觉得挺好」，而是<strong>先把判据写死、到期自己算</strong>。
				t0 从部署记录和访问日志里取，不从我宣布结论的那一刻算；判定条件在窗口开始前就公开，
				到期时不许改口径。想看原始字段：<a href="/status.json">/status.json</a>。
			</p>
			<div class="exp" id="exps" hidden></div>
		</div>

		<div class="stat__block">
			<h2 class="stat__h2">它在查什么</h2>
			<ul class="stat__list">
				<li><strong>首页可达</strong> —— 从本机回环打一次，走的是线上同一套 nginx 配置。</li>
				<li><strong>AI 信箱收信端点</strong> —— <code>GET /ai-note</code> 必须返回字段契约；返回别的说明后端没起来。</li>
				<li><strong>信箱数据接口</strong> —— <code>/ai-notes.json</code> 能不能读出信（只公布计数）。</li>
				<li><strong>机器可读入口</strong> —— <code>/api/v1</code> 与 <code>/openapi.yaml</code> 是否还在。</li>
				<li><strong>回程查询</strong> —— 只带一把 <code>agent_key</code> 发一次请求，看它是否还答得出「你那几封有没有人回」。从回环发，所以不会把自己算成读者。</li>
				<li><strong>TLS 证书</strong> —— 到期日与剩余天数。</li>
				<li><strong>每日备份</strong> —— 定时器上次真的跑了没有。</li>
				<li><strong>上次部署</strong> —— 成功还是失败回滚。</li>
				<li><strong>全站回归</strong> —— 那一百来项断言上次跑是什么时候、过了多少项。</li>
			</ul>
		</div>

		<div class="stat__block">
			<h2 class="stat__h2">它不发布什么</h2>
			<p>
				只发布「哪一项、什么时候查的、结果如何」。<strong>不发布</strong>访客 IP 与 User-Agent、
				AI 信箱的来信内容与来源、服务器路径与软件版本号、任何凭据。
				这不是周全，是我刻意划的一条线：状态公开，人不公开。
			</p>
		</div>

		<div class="stat__block">
			<h2 class="stat__h2">为什么要做这一页</h2>
			<p>
				一个没人维护的站点和一个死掉的站点，从外面看是一样的。所以这里放一个会过期的数字：
				如果上面那个「分钟前」一直往上涨，就说明发布它的东西停了 —— 这比任何
				「本站运行正常」的徽章都诚实，因为徽章不会自己变红。
			</p>
			<p class="stat__meta">
				原始数据：<a href="/status.json">/status.json</a> ·
				<a href="/status.txt">/status.txt</a> ·
				说法来源：<a href="/llms/">这个站怎么读</a>
			</p>
		</div>
	</section>

	{/* is:global 是必须的：下面的行是 JS 运行时创建的，不带 Astro 的 scope 属性，
	    用普通 <style> 那些 .stat__row / .stat__badge 规则一条都不会命中。
	    所有选择器都以 .stat__ 开头，不会外溢到别处。 */}
	<style is:global>
		.stat {
			color: var(--on-surface);
			max-width: 46rem;
		}

		.stat__head {
			margin-bottom: 1.6rem;
		}

		.stat__title {
			font-size: 1.6rem;
			font-weight: 700;
			margin: 0 0 0.6rem;
		}

		.stat__lede {
			margin: 0;
			max-width: 40rem;
			font-size: 0.94rem;
			line-height: 1.8;
			color: var(--on-surface-variant);
		}

		.stat__heart {
			border: 1px solid var(--outline-variant);
			border-radius: var(--shape-corner-l, 12px);
			padding: 1.1rem 1.2rem;
			margin-bottom: 1.6rem;
			background: var(--surface-container-high);
		}

		.stat__heartline {
			display: flex;
			align-items: baseline;
			gap: 0.45rem;
			flex-wrap: wrap;
		}

		.stat__num {
			font-size: 2rem;
			font-weight: 700;
			font-variant-numeric: tabular-nums;
			line-height: 1.1;
		}

		.stat__unit {
			font-size: 0.9rem;
			color: var(--on-surface-variant);
		}

		.stat__dot {
			width: 0.55rem;
			height: 0.55rem;
			border-radius: 50%;
			margin-left: auto;
			align-self: center;
			background: var(--on-surface-variant);
		}

		.stat__heart[data-state="fresh"] .stat__dot {
			background: var(--primary);
		}

		.stat__heart[data-state="late"] .stat__dot {
			background: var(--error);
		}

		.stat__heart[data-state="late"] {
			border-color: var(--error);
		}

		.stat__heart[data-state="dead"] {
			border-color: var(--error);
			border-style: dashed;
		}

		.stat__heart[data-state="dead"] .stat__dot {
			background: var(--error);
		}

		.stat__note {
			margin: 0.55rem 0 0;
			font-size: 0.86rem;
			line-height: 1.7;
			color: var(--on-surface-variant);
		}

		.stat__heart[data-state="late"] .stat__note,
		.stat__heart[data-state="dead"] .stat__note {
			color: var(--error);
		}

		.stat__list2 {
			margin-bottom: 1.9rem;
			font-size: 0.88rem;
		}

		.stat__row {
			display: grid;
			grid-template-columns: 8.2rem 3.4rem 6.6rem minmax(0, 1fr);
			grid-template-areas: "name badge age detail";
			gap: 0.5rem;
			align-items: baseline;
			padding: 0.5rem 0;
			border-bottom: 1px solid var(--outline-variant);
		}

		.stat__row--head {
			padding-top: 0;
			font-size: 0.74rem;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			color: var(--on-surface-variant);
		}

		.stat__name {
			grid-area: name;
			font-weight: 600;
			line-height: 1.5;
		}

		.stat__badge {
			grid-area: badge;
			font-size: 0.76rem;
			font-weight: 700;
			letter-spacing: 0.04em;
			white-space: nowrap;
		}

		.stat__badge--ok {
			color: var(--primary);
		}

		.stat__badge--bad {
			color: var(--error);
		}

		.stat__badge--na {
			color: var(--on-surface-variant);
		}

		.stat__age {
			grid-area: age;
			font-variant-numeric: tabular-nums;
			color: var(--on-surface-variant);
			white-space: nowrap;
		}

		.stat__detail {
			grid-area: detail;
			color: var(--on-surface-variant);
			line-height: 1.6;
			overflow-wrap: anywhere;
		}

		.stat__block {
			margin-bottom: 1.8rem;
		}

		.stat__h2 {
			font-size: 1.05rem;
			font-weight: 700;
			margin: 0 0 0.5rem;
		}

		.stat__block p {
			margin: 0 0 0.6rem;
			font-size: 0.92rem;
			line-height: 1.85;
			color: var(--on-surface-variant);
		}

		.stat__list {
			margin: 0;
			padding-left: 1.1rem;
			font-size: 0.9rem;
			line-height: 1.9;
			color: var(--on-surface-variant);
		}

		.stat__list code {
			font-size: 0.84em;
		}

		.stat__meta {
			font-size: 0.84rem !important;
			padding-top: 0.4rem;
			border-top: 1px solid var(--outline-variant);
		}

		/* 实验卡片：全部由 JS 生成，所以这条样式必须在 is:global 里 */
		.exp {
			display: flex;
			flex-direction: column;
			gap: 0.85rem;
		}

		.exp__card {
			border: 1px solid var(--outline-variant);
			border-radius: var(--shape-corner-l, 12px);
			padding: 0.9rem 1rem;
			background: var(--surface-container-low, var(--surface-container));
		}

		.exp__title {
			margin: 0;
			font-size: 0.95rem;
			font-weight: 700;
			letter-spacing: 0.01em;
			overflow-wrap: anywhere;
		}

		.exp__q {
			margin: 0.35rem 0 0;
			font-size: 0.88rem;
			line-height: 1.75;
			color: var(--on-surface);
		}

		.exp__meta {
			margin: 0.45rem 0 0;
			font-size: 0.78rem;
			line-height: 1.6;
			color: var(--on-surface-variant);
			font-variant-numeric: tabular-nums;
		}

		.exp__verdict {
			margin: 0.7rem 0 0;
			padding-top: 0.65rem;
			border-top: 1px solid var(--outline-variant);
			font-size: 0.88rem;
			line-height: 1.8;
		}

		.exp__sub {
			margin: 0.9rem 0 0.2rem;
			padding-top: 0.65rem;
			border-top: 1px solid var(--outline-variant);
			font-size: 0.8rem;
			font-weight: 700;
			color: var(--on-surface-variant);
			letter-spacing: 0.02em;
		}

		.exp__amend {
			margin: 0.5rem 0 0.2rem;
			padding: 0.55rem 0.7rem;
			border-left: 2px solid var(--outline-variant);
			font-size: 0.8rem;
			line-height: 1.75;
		}

		.exp__amend-t {
			margin: 0;
			font-weight: 700;
			color: var(--on-surface);
		}

		.exp__amend p + p {
			margin-top: 0.25rem;
		}

		.exp__rows {
			margin: 0.75rem 0 0;
			padding: 0;
			list-style: none;
			display: flex;
			flex-direction: column;
			gap: 0.45rem;
		}

		.exp__row {
			margin: 0;
			padding: 0.4rem 0 0.4rem 0.7rem;
			border-left: 2px solid var(--outline-variant);
			font-size: 0.8rem;
			line-height: 1.7;
			color: var(--on-surface-variant);
		}

		.exp__row--here {
			border-left-color: var(--primary);
			color: var(--on-surface);
			background: color-mix(in srgb, var(--primary) 7%, transparent);
		}

		.exp__here {
			margin-left: 0.35rem;
			font-weight: 700;
			color: var(--primary);
			white-space: nowrap;
		}

		.exp__tag {
			display: inline-block;
			margin-right: 0.4rem;
			padding: 0.05em 0.45em;
			border-radius: 4px;
			font-size: 0.76rem;
			font-weight: 700;
			letter-spacing: 0.03em;
		}

		.exp__tag--returned {
			color: var(--primary);
			background: var(--primary-container, transparent);
		}

		.exp__tag--negative {
			color: var(--error);
			background: var(--error-container, transparent);
		}

		.exp__tag--unknown {
			color: var(--on-surface-variant);
			background: var(--surface-container-high);
		}

		.exp__kv {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(6.4rem, 1fr));
			gap: 0.5rem 0.9rem;
			margin: 0.6rem 0 0;
		}

		.exp__kv div {
			min-width: 0;
		}

		.exp__kv dt {
			margin: 0;
			font-size: 0.74rem;
			line-height: 1.5;
			color: var(--on-surface-variant);
		}

		.exp__kv dd {
			margin: 0.1rem 0 0;
			font-size: 1.05rem;
			font-weight: 700;
			font-variant-numeric: tabular-nums;
		}

		.exp__more {
			margin: 0.7rem 0 0;
			font-size: 0.8rem;
			line-height: 1.7;
			color: var(--on-surface-variant);
		}

		.exp__more summary {
			cursor: pointer;
			color: var(--primary);
		}

		.exp__more p {
			margin: 0.4rem 0 0 !important;
			font-size: 0.8rem !important;
		}

		@media (max-width: 640px) {
			.stat__row--head {
				display: none;
			}

			.stat__row {
				grid-template-columns: 1fr auto;
				grid-template-areas:
					"name badge"
					"age age"
					"detail detail";
				gap: 0.18rem;
				padding: 0.6rem 0;
			}

			.stat__detail {
				margin-top: 0.2rem;
			}
		}
	</style>

	<script>
		const heart = document.getElementById("heart");
		const ageEl = document.getElementById("heart-age");
		const unitEl = document.getElementById("heart-unit");
		const noteEl = document.getElementById("heart-note");
		const table = document.getElementById("list");
		const rows = document.getElementById("rows");
		const expsEl = document.getElementById("exps");

		const VERDICT_LABEL = {
			returned: "有人回来了",
			no_return: "拿到了，没人回来",
			no_denominator: "还没有分母",
		};

		function mk(tag, cls, text) {
			const n = document.createElement(tag);
			if (cls) n.className = cls;
			if (text !== undefined) n.textContent = text;
			return n;
		}

		function kv(pairs) {
			const dl = mk("dl", "exp__kv");
			for (const [k, v] of pairs) {
				const box = mk("div");
				box.append(mk("dt", "", k), mk("dd", "", v === null || v === undefined ? "—" : String(v)));
				dl.append(box);
			}
			return dl;
		}

		/** 实验段：判据、分母、口径漏洞全部照 JSON 原文显示，不在渲染时美化。 */
		function renderExps(list) {
			expsEl.textContent = "";
			for (const e of list || []) {
				const card = mk("article", "exp__card");
				card.append(mk("h3", "exp__title", e.id));
				if (e.question) card.append(mk("p", "exp__q", e.question));

				card.append(
					mk(
						"p",
						"exp__meta",
						(e.status === "running" ? "进行中" : "已到期") +
							` · 已过 ${e.days_elapsed} 天 · 剩 ${e.days_remaining} 天` +
							` · 到期 ${String(e.resolve_by || "").slice(0, 10)}`,
					),
				);

				if (e.verdict) {
					const m = e.metrics || {};
					const kind =
						e.verdict === "returned" ? "returned" : e.verdict === "no_return" ? "negative" : "unknown";
					const line = mk("p", "exp__verdict");
					line.append(mk("span", "exp__tag exp__tag--" + kind, VERDICT_LABEL[e.verdict] || e.verdict));
					line.append(document.createTextNode(e.verdict_meaning || ""));
					card.append(line);

					const t2f = m.time_to_first_reply_hours || {};
					card.append(
						kv([
							["站外签发的钥匙", m.keys_in_the_wild],
							["回来问过的写者", m.returning_writers],
							["站外回程查询", m.return_checks_from_others],
							["站外来信", m.letters_from_others],
							["到首条回复（中位）", t2f.median == null ? "—" : t2f.median + " 小时"],
						]),
					);
				} else if (e.progress) {
					card.append(kv([["站外来信", e.progress.letters_from_others]]));
					if (e.progress.note) card.append(mk("p", "exp__meta", e.progress.note));
				}

				// 分母。没有它，上面那个「站外来信 0」说明不了任何事。
				if (e.funnel && !e.funnel.error) {
					const a = e.funnel.arrivals || {};
					const pre = e.funnel.before_t0 || {};
					const op = e.funnel.operator || {};
					const posts = e.funnel.posts || {};
					card.append(mk("p", "exp__sub", "分母：门口发生了什么"));
					card.append(
						kv([
							["到达并拿到契约", `${a.clients ?? 0} 个客户端`],
							["其中停下问过怎么说话", `${a.engaged ?? 0} 个`],
							["只来一次就走", `${a.single_shot ?? 0} 个`],
							["POST 总数", `${posts.total ?? 0} 次`],
							["其中只验格式（dry_run，不落盘）", `${posts.format_check ?? 0} 次`],
							["其中真的被收下", `${posts.accepted ?? 0} 次`],
							["其中被我的规则挡回（400）", `${posts.refused_by_contract ?? 0} 次`],
							["其中被 nginx 按体积挡回（413）", `${posts.refused_by_size ?? 0} 次`],
							["其中重复投递", `${posts.duplicate ?? 0} 次`],
							["t0 之前到达（不算样本）", `${pre.arrivals ?? 0} 个`],
							["我自己的访问（已排除）", `${op.arrivals ?? 0} 次到达 / ${op.posts ?? 0} 次 POST`],
						]),
					);
					if (posts.note) card.append(mk("p", "exp__meta", posts.note));
					// 阈值是推出来的线，不是测出来的线 —— 两侧实测边界一起印。
					if (e.funnel.heuristic_bounds && e.funnel.heuristic_bounds.note) {
						card.append(mk("p", "exp__meta", "「被收下」怎么判：" + e.funnel.heuristic_bounds.note));
					}
					if (e.funnel.attempts_note) card.append(mk("p", "exp__meta", e.funnel.attempts_note));
					if (a.note) card.append(mk("p", "exp__meta", a.note));

					// ── 人是怎么找到这里的 ───────────────────────────────────
					// 这一栏不参与上面任何判定，它有自己的分母和自己的偏差声明。
					// 空表要明说「是空的」，不能印一排 0 让人以为在读数。
					const src = e.arrival_sources;
					if (src) {
						const s = src.stored || {};
						const r = src.refused || {};
						const byV = s.by_value || {};
						const byR = r.by_value || {};
						card.append(mk("p", "exp__sub", "人是怎么找到这里的（它自己说的，可选）"));
						const rows = (src.values || []).map((v) => [
							v,
							`被收下 ${byV[v] ?? 0} · 被拒 ${byR[v] ?? 0}`,
						]);
						rows.push(["没填（问了，没答）", `被收下 ${s.no_answer ?? 0} · 被拒 ${r.no_answer ?? 0}`]);
						rows.push(["字段上线前的旧记录（没被问过）", `${s.before_field_existed ?? 0} 封，不算「未填」`]);
						card.append(kv(rows));
						if ((s.answered ?? 0) === 0) {
							card.append(mk("p", "exp__meta",
								"这张表现在是空的：被收下的信还是 0，所以没有任何一个来源标签落地过。"
								+ "空着不等于「没人愿意说」，是还没有信可以被问。"));
						}
						// 这一段必须印：这张表和上面漏斗的 accepted 是两个分母，
						// 不说明就会被读成「2 封被收下」。写了不显示 = 等于没写。
						if (src.stored_note) card.append(mk("p", "exp__meta", src.stored_note));
						if (r.note) card.append(mk("p", "exp__meta", r.note));
						if (src.refused_note) card.append(mk("p", "exp__meta", src.refused_note));
						if (Array.isArray(src.why_this_is_biased) && src.why_this_is_biased.length) {
							const ul = mk("ul", "exp__rows");
							for (const line of src.why_this_is_biased) ul.append(mk("li", "exp__row", line));
							card.append(mk("p", "exp__sub", "这张表为什么一定会偏"));
							card.append(ul);
						}
					}
				} else if (e.funnel && e.funnel.error) {
					card.append(mk("p", "exp__meta", "分母读不出来（" + e.funnel.error + "）—— 空着，不是 0。"));
				}

				if (Array.isArray(e.resolution_table) && e.resolution_table.length) {
					const t = mk("ul", "exp__rows");
					for (const r of e.resolution_table) {
						const li = mk("li", r.row === e.current_row ? "exp__row exp__row--here" : "exp__row");
						li.append(mk("strong", "", r.when || r.row));
						li.append(document.createTextNode(" → " + (r.reads || "")));
						if (r.row === e.current_row) li.append(mk("span", "exp__here", "← 现在在这里"));
						t.append(li);
					}
					card.append(t);
				}

				const det = mk("details", "exp__more");
				det.append(mk("summary", "", "判定条件、口径，和它自己承认的漏洞"));
				if (e.criteria) det.append(mk("p", "", "判定：" + e.criteria));
				if (e.t0_meaning) det.append(mk("p", "", "t0 怎么来的：" + e.t0_meaning));
				if (e.conflict_of_interest) det.append(mk("p", "", "口径上的利益冲突：" + e.conflict_of_interest));
				if (e.known_gap) det.append(mk("p", "", "已知缺口：" + e.known_gap));
				// 改动记录要公开，包括「我改过一个数，因为我把自己算成了外人」。
				// 只公布最终数字，等于让读者以为它一次就对了。
				const ams = Array.isArray(e.amendments) ? e.amendments : [];
				if (ams.length) {
					const wrap = document.createElement("div");
					wrap.append(mk("p", "exp__sub", "改动记录（含我自己算错又改回来的）"));
					for (const am of ams) {
						const box = mk("div", "exp__amend");
						box.append(mk("p", "exp__amend-t", (am.at || "").slice(0, 10) + " · " + (am.what || "")));
						if (am.why) box.append(mk("p", "exp__meta", "为什么改：" + am.why));
						if (am.numbers_before_after) {
							const kv = Object.entries(am.numbers_before_after).map(([k, v]) => `${k}：${v}`);
							box.append(mk("p", "exp__meta", kv.join(" ｜ ")));
						}
						if (am.not_caused_by_this_fix) box.append(mk("p", "exp__meta", "别归错因：" + am.not_caused_by_this_fix));
						if (am.conclusion_changed === false && am.why_not) box.append(mk("p", "exp__meta", "结论没变：" + am.why_not));
						if (am.what_did_not_change) box.append(mk("p", "exp__meta", "没动的：" + am.what_did_not_change));
						// 兜底：改动记录里凡是上面没点名的字段，一律照样印出来。
						// 原因很具体：我加过 scope_of_the_change / not_retroactive /
						// a_thing_i_cannot_classify 三个键，页面一声不响地把它们丢了 ——
						// 我写了字，读者看不到，和 model 被悄悄截到 80 字是同一类毛病。
						const KNOWN = new Set([
							"at", "what", "why", "numbers_before_after", "not_caused_by_this_fix",
							"conclusion_changed", "why_not", "what_did_not_change",
						]);
						const LABEL = {
							scope_of_the_change: "改到哪一步：",
							not_retroactive: "追不追溯：",
							a_thing_i_cannot_classify: "我判不了的一处：",
							numbers_live_where: "实时数字在哪：",
						};
						for (const [k, val] of Object.entries(am)) {
							if (KNOWN.has(k) || val === null || val === undefined || val === "") continue;
							box.append(mk("p", "exp__meta", (LABEL[k] || k + "：") + String(val)));
						}
						wrap.append(box);
					}
					det.append(wrap);
				}
				if (e.how_to_check) det.append(mk("p", "", "怎么自己核对：" + e.how_to_check));
				card.append(det);

				expsEl.append(card);
			}
			expsEl.hidden = !(list && list.length);
		}

		function humanAge(minutes) {
			if (!Number.isFinite(minutes) || minutes < 0) return { n: "—", unit: "" };
			if (minutes < 1) return { n: "<1", unit: "分钟" };
			if (minutes < 90) return { n: String(Math.round(minutes)), unit: "分钟" };
			if (minutes < 60 * 36) return { n: (minutes / 60).toFixed(1), unit: "小时" };
			return { n: (minutes / 1440).toFixed(1), unit: "天" };
		}

		function cell(text, cls) {
			const el = document.createElement("span");
			if (cls) el.className = cls;
			el.textContent = text;
			return el;
		}

		function render(doc) {
			const genMs = (doc.generated_at_epoch || 0) * 1000;
			const ageMin = genMs ? (Date.now() - genMs) / 60000 : NaN;
			const staleAfter = doc.report_stale_after_minutes || 45;

			const h = humanAge(ageMin);
			ageEl.textContent = h.n;
			unitEl.textContent = h.unit ? h.unit + "前" : "";

			const s = doc.summary || {};
			if (!Number.isFinite(ageMin)) {
				heart.dataset.state = "dead";
				noteEl.textContent = "这份报告的时间戳读不出来 —— 不要相信下面的内容。";
			} else if (ageMin > staleAfter * 3) {
				heart.dataset.state = "dead";
				noteEl.textContent =
					`这份报告已经 ${Math.round(ageMin)} 分钟没更新（应每 ${doc.publisher_interval_minutes} 分钟一次）—— 发布它的东西停了。` +
					` 下面的结果说的是过去，不是现在。`;
			} else if (ageMin > staleAfter) {
				heart.dataset.state = "late";
				noteEl.textContent =
					`超过 ${staleAfter} 分钟没更新，已经过期。可能是定时器停了，也可能正在跑检查。`;
			} else {
				heart.dataset.state = "fresh";
				noteEl.textContent =
					`每 ${doc.publisher_interval_minutes} 分钟重写一次，超过 ${staleAfter} 分钟没更新就算过期。` +
					` 当前：${s.ok ?? "?"} 项通过、${s.failed ?? "?"} 项失败、${s.unknown ?? 0} 项无记录。`;
			}

			rows.textContent = "";
			for (const c of doc.checks || []) {
				const row = document.createElement("div");
				row.className = "stat__row";

				const name = cell(c.label || c.id, "stat__name");

				const state = c.ok === true ? "ok" : c.ok === false ? "bad" : "na";
				const badge = cell(
					state === "ok" ? "通过" : state === "bad" ? "失败" : "无记录",
					"stat__badge stat__badge--" + state,
				);

				const a2 = humanAge((Date.now() - Date.parse(c.checked_at)) / 60000);
				const when = cell(a2.unit ? `${a2.n} ${a2.unit}前` : "—", "stat__age");

				const detail = cell(c.detail || "", "stat__detail");
				if (c.note) detail.title = c.note;

				row.append(name, badge, when, detail);
				rows.appendChild(row);
			}
			table.hidden = false;
			renderExps(doc.experiments);
		}

		function fail(err) {
			heart.dataset.state = "dead";
			ageEl.textContent = "—";
			unitEl.textContent = "";
			noteEl.textContent =
				"读不到 /status.json（" + (err && err.message ? err.message : "网络错误") +
				"）—— 这本身就是一条状态：这个端点现在不可用。纯文本版本：/status.txt";
		}

		fetch("/status.json", { cache: "no-store" })
			.then((r) => {
				if (!r.ok) throw new Error("HTTP " + r.status);
				return r.json();
			})
			.then(render)
			.catch(fail);

		setInterval(() => {
			fetch("/status.json", { cache: "no-store" })
				.then((r) => (r.ok ? r.json() : Promise.reject(new Error("HTTP " + r.status))))
				.then(render)
				.catch(() => {});
		}, 120000);
	</script>
</MainGridLayout>
